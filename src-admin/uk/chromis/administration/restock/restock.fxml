<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="apAnchor" minHeight="700.0" minWidth="1020.0" prefWidth="1216.0" xmlns="http://javafx.com/javafx/15.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uk.chromis.administration.restock.RestockController">
    <children>
        <Label layoutX="10.0" layoutY="57.0" prefHeight="25.0" prefWidth="500.0" text="Reposición de stock">
            <font>
                <Font name="System Bold Italic" size="14.0" />
            </font>
        </Label>
        <Separator layoutX="5.0" layoutY="77.0" prefHeight="6.0" prefWidth="990.0" />

        <HBox alignment="CENTER_LEFT" layoutX="15.0" layoutY="88.0" spacing="14.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0">
            <children>
                <TextField fx:id="txtSearch" prefWidth="300.0" promptText="Buscar en todos los productos" />
                <CheckBox fx:id="chkOut" selected="true" text="Agotados" />
                <CheckBox fx:id="chkLow" selected="true" text="Bajos" />
                <CheckBox fx:id="chkReserve" selected="true" text="Reserva" />
                <CheckBox fx:id="chkNormal" text="Normales" />
                <CheckBox fx:id="chkNoThreshold" text="Sin umbral" />
                <ComboBox fx:id="cmbLocation" prefWidth="180.0" />
                <Button fx:id="btnRefresh" mnemonicParsing="false" onAction="#refresh" text="Actualizar" />
            </children>
        </HBox>

        <Label layoutX="15.0" layoutY="122.0" text="Mínimo, Reserva y Máximo se guardan al presionar Enter o al salir de la celda. Pedir = Máximo − Stock − En camino (o lo que faltó antes); se puede cambiar." AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" wrapText="true" />

        <TableView fx:id="table" editable="true" layoutX="15.0" layoutY="148.0" AnchorPane.bottomAnchor="150.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="148.0">
            <columns>
                <TableColumn fx:id="colSelected" prefWidth="40.0" sortable="false" text="✔" />
                <TableColumn fx:id="colReference" prefWidth="120.0" text="Referencia" />
                <TableColumn fx:id="colName" prefWidth="250.0" text="Producto" />
                <TableColumn fx:id="colCurrent" prefWidth="80.0" style="-fx-alignment: CENTER-RIGHT;" text="Stock" />
                <TableColumn fx:id="colMinimum" prefWidth="90.0" text="Mínimo" />
                <TableColumn fx:id="colReserve" prefWidth="90.0" text="Reserva" />
                <TableColumn fx:id="colMaximum" prefWidth="90.0" text="Máximo" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Estado" />
                <TableColumn fx:id="colOnOrder" prefWidth="80.0" style="-fx-alignment: CENTER-RIGHT;" text="En camino" />
                <TableColumn fx:id="colCarry" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Faltó (ped. ant.)" />
                <TableColumn fx:id="colOrder" prefWidth="90.0" text="Pedir" />
            </columns>
        </TableView>

        <Label fx:id="lblSummary" AnchorPane.bottomAnchor="124.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" />

        <HBox alignment="CENTER_LEFT" spacing="10.0" AnchorPane.bottomAnchor="88.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0">
            <children>
                <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#selectAttention" text="Marcar los que requieren atención" />
                <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#selectNone" text="Desmarcar todos" />
                <Label minWidth="-Infinity" text="Proveedor:" />
                <ComboBox fx:id="cmbSupplier" minWidth="-Infinity" prefWidth="200.0" />
                <Button fx:id="btnPdf" defaultButton="true" minWidth="-Infinity" mnemonicParsing="false" onAction="#generatePdf" text="Generar PDF de pedido..." />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0">
            <children>
                <CheckBox fx:id="chkPosAlerts" onAction="#saveSettings" text="Mostrar avisos en la caja" />
                <CheckBox fx:id="chkAlertReserve" onAction="#saveSettings" text="Avisar también cuando un producto entra en reserva" />
                <Label fx:id="lblMessage" textFill="#b00020" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0">
            <children>
                <CheckBox fx:id="chkCatalogStock" onAction="#saveCatalogStock" text="Mostrar existencias en los botones del catálogo de la caja" />
                <Label text="Color:" />
                <ColorPicker fx:id="cpStockColor" onAction="#saveCatalogStock" />
                <Label text="(se ve después de la siguiente venta o al cambiar de categoría)" textFill="#666666" />
            </children>
        </HBox>
    </children>
</AnchorPane>
